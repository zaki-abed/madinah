# مثال فقط. الملف الحقيقي (.env) ينشئه الأمر: npm run db:setup
# ولا يُرفع إلى المستودع أبداً.

# دور التطبيق (صلاحيات محدودة): يستعمله الخادم
DATABASE_URL=postgres://madinah_app:CHANGE_ME@localhost:5432/madinah_dev
# دور المالك: للـ migrations وأمر create-admin فقط
MIGRATION_DATABASE_URL=postgres://madinah_owner:CHANGE_ME@localhost:5432/madinah_dev

# قاعدة الاختبارات (تُفرَّغ وتُبنى من جديد مع كل تشغيل للاختبارات)
TEST_DATABASE_URL=postgres://madinah_app:CHANGE_ME@localhost:5432/madinah_test
TEST_MIGRATION_DATABASE_URL=postgres://madinah_owner:CHANGE_ME@localhost:5432/madinah_test

HOST=127.0.0.1
PORT=3001
# true عند التشغيل على HTTPS
COOKIE_SECURE=false
